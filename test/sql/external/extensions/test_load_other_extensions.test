# name: test/sql/external/extensions/test_load_other_extensions.test
# description: Test extension-download errors through the curl client
# group: [curl_client]

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
SET httpfs_client_implementation='curl';

statement error
INSTALL non_existent_extension;
----
<REGEX>:.*HTTP Error: Failed to download extension.*
