# name: test/sql/s3/csv_s3_file_size_bytes.test
# description: FILE_SIZE_BYTES splits a CSV COPY to S3 without losing rows
# group: [s3]

require httpfs

# override the default behaviour of skipping HTTP errors and connection failures: this test fails on connection issues
set ignore_error_messages

# different vector sizes result in different number of files
require no_vector_verification

statement ok
CREATE TABLE bigdata AS SELECT i AS col_a, i AS col_b FROM range(0,10000) tbl(i);

statement ok
set threads=1

# parameter in bytes
statement ok
COPY (FROM bigdata) TO '{TEMP_DIR}/file_size_bytes_csv1' (FORMAT CSV, FILE_SIZE_BYTES 1000);

query I
SELECT COUNT(*) FROM read_csv_auto('{TEMP_DIR}/file_size_bytes_csv1/*.csv')
----
10000

# FILE_SIZE_BYTES must split the output into multiple files. The exact file count
# is chunking/vector-size sensitive (see 'require no_vector_verification' and the
# comment above) and shifts across duckdb versions, so assert that splitting
# occurred rather than pinning an exact number.
query I
SELECT count(*) > 1 FROM glob('{TEMP_DIR}/file_size_bytes_csv1/*.csv')
----
true
