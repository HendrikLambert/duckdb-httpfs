# name: test/sql/http/settings/test_disabled_file_system_httpfs.test
# description: Disabling local files does not disable HTTP, but disabling HTTPFileSystem does
# group: [settings]

require skip_reload

require no_extension_autoloading "EXPECTED: Test disable loading from local file system"

statement ok
PRAGMA enable_verification

require httpfs

statement ok
SET disabled_filesystems='LocalFileSystem';

# HTTP remains available when only local files are disabled.
query I
SELECT count(*) FROM read_csv_auto('{DATA_DIR}/customer.csv');
----
10

statement ok
SET disabled_filesystems='LocalFileSystem,HTTPFileSystem';

# HTTP reads fail after HTTPFileSystem is also disabled.
statement error
FROM read_csv_auto('{DATA_DIR}/customer.csv');
----
File system HTTPFileSystem has been disabled by configuration
