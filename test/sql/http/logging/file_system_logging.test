# name: test/sql/http/logging/file_system_logging.test
# description: Filesystem tracing records local and HTTP open, read, write, and close operations
# group: [logging]

require parquet

require noforcestorage

statement ok
set enable_logging = true;

statement ok
set logging_level='trace';

statement ok
COPY (SELECT 1 as a) TO '{LOCAL_TEMP_DIR}/test.csv'

statement ok
FROM '{LOCAL_TEMP_DIR}/test.csv'

statement ok
pragma threads=1

# Note: regex for test stability
query IIII
SELECT scope, type, log_level, regexp_replace(message, '\"path\":.*test.csv"', '"test.csv"')
FROM duckdb_logs
WHERE type = 'FileSystem'
ORDER BY timestamp
----
CONNECTION	FileSystem	TRACE	{"fs":"LocalFileSystem","test.csv","op":"OPEN"}
CONNECTION	FileSystem	TRACE	{"fs":"LocalFileSystem","test.csv","op":"WRITE","bytes":"4","pos":"0"}
CONNECTION	FileSystem	TRACE	{"fs":"LocalFileSystem","test.csv","op":"CLOSE"}
CONNECTION	FileSystem	TRACE	{"fs":"LocalFileSystem","test.csv","op":"OPEN"}
CONNECTION	FileSystem	TRACE	{"fs":"LocalFileSystem","test.csv","op":"READ","bytes":"4","pos":"0"}
CONNECTION	FileSystem	TRACE	{"fs":"LocalFileSystem","test.csv","op":"CLOSE"}

statement ok
CALL truncate_duckdb_logs();

require httpfs

statement ok
FROM '{DATA_DIR}/customer.csv'

query IIII
SELECT scope, type, log_level, regexp_replace(message, '\"path\":.*test.csv"', '"test.csv"')
FROM duckdb_logs
WHERE type = 'FileSystem' AND message NOT LIKE '%duckdb_extension%' AND message ILIKE '%HTTPFileSystem%'
ORDER BY timestamp
----
CONNECTION	FileSystem	TRACE	{"fs":"HTTPFileSystem","path":"{DATA_DIR}/customer.csv","op":"OPEN"}
CONNECTION	FileSystem	TRACE	{"fs":"HTTPFileSystem","path":"{DATA_DIR}/customer.csv","op":"READ","bytes":"1276","pos":"0"}
CONNECTION	FileSystem	TRACE	{"fs":"HTTPFileSystem","path":"{DATA_DIR}/customer.csv","op":"CLOSE"}
