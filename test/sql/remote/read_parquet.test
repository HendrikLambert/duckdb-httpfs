# name: test/sql/remote/read_parquet.test
# description: Read the same Parquet fixture through each remote filesystem backend
# group: [parquet]

require httpfs

require parquet

query IIII
SELECT id, first_name, last_name, email
FROM PARQUET_SCAN('{DATA_DIR}/userdata1.parquet')
LIMIT 10;
