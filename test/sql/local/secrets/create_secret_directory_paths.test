# name: test/sql/local/secrets/create_secret_directory_paths.test
# description: Persistent secret directories reject file collisions and create nested paths
# group: [secrets]

statement ok
PRAGMA enable_verification;

load {TEST_DIR}/create_secret_directory_paths.db

require httpfs

# Create a regular file where a secret directory will be requested.
statement ok
COPY (SELECT 1 as a) to '{TEST_DIR}/secret_directory_collision'

# Point secret storage at the regular file.
statement ok
set secret_directory='{TEST_DIR}/secret_directory_collision'

# Temporary secrets remain usable because they do not need the persistent directory.
statement ok
CREATE SECRET my_tmp_secret (
	TYPE S3,
    SCOPE 's3://bucket1'
)

# Persistent creation reports that the configured path is not a directory.
statement error
CREATE PERSISTENT SECRET my_tmp_secret (
	TYPE S3,
    SCOPE 's3://bucket2'
)
----
<REGEX>:.*Failed to initialize persistent storage directory.*path exists but is not a directory.*

restart

# A valid deeply nested directory is created automatically.
statement ok
set secret_directory='{TEST_DIR}/create_secret_directory_paths/a/deeply/nested/folder/will/be/created'

statement ok
CREATE PERSISTENT SECRET my_tmp_secret (
	TYPE S3,
    SCOPE 's3://bucket2'
)
