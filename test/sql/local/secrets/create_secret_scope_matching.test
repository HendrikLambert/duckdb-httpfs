# name: test/sql/local/secrets/create_secret_scope_matching.test
# description: Secret selection prefers specific scopes and resolves equal matches deterministically
# group: [secrets]

load {TEST_DIR}/create_secret_scope_matching.db

statement ok
PRAGMA enable_verification;

require httpfs

statement ok
set secret_directory='{TEST_DIR}/create_secret_scope_matching'

# No match
query I
SELECT name FROM which_secret('s3://', 's3')
----

statement ok
CREATE TEMPORARY SECRET t1 ( TYPE S3 )

statement ok
CREATE TEMPORARY SECRET t2 ( TYPE S3 )

statement ok
CREATE SECRET p1 IN LOCAL_FILE ( TYPE S3 )

# This ties within the same storage: the two temporary secrets s1 and s2 both score identically. We solve this by
# tie-breaking on secret name alphabetical ordering
query I
SELECT name FROM which_secret('s3://', 's3')
----
t1

query III
FROM which_secret('s3://', 's3')
----
t1	TEMPORARY	memory

statement ok
DROP SECRET t1

# Temporary secrets take preference over persistent ones.
query I
SELECT name FROM which_secret('s3://', 's3')
----
t2

statement ok
DROP SECRET t2

query I
SELECT name FROM which_secret('s3://', 's3')
----
p1

statement ok
DROP SECRET p1

# Prefer the longest matching scope, then fall back to the broader scope.
statement ok
CREATE TEMPORARY SECRET broad (TYPE S3, SCOPE 's3://bucket')

statement ok
CREATE TEMPORARY SECRET specific (TYPE S3, SCOPE 's3://bucket/path')

query I
SELECT name FROM which_secret('s3://bucket/path/file.parquet', 's3')
----
specific

query I
SELECT name FROM which_secret('s3://bucket/other/file.parquet', 's3')
----
broad

query I
SELECT name FROM which_secret('s3://other/file.parquet', 's3')
----

statement ok
DROP SECRET broad

statement ok
DROP SECRET specific
