# name: test/sql/local/secrets/create_secret_serialization.test
# description: S3, R2, and GCS secrets preserve metadata and redacted/unredacted values across restart
# group: [secrets]

require httpfs

load {TEST_DIR}/test_serialize_secrets.db

statement ok
PRAGMA enable_verification;

statement ok
set secret_directory='{TEST_DIR}/create_secret_serialization'

statement ok
CREATE OR REPLACE PERSISTENT SECRET s1 (
    TYPE S3,
    PROVIDER config,
    SCOPE 's3://my_s3_scope',
    KEY_ID 'mekey',
    SECRET 'mesecret',
    REGION 'meregion',
    SESSION_TOKEN 'mesesh',
    ENDPOINT 'meendpoint',
    URL_STYLE 'mahstyle',
    USE_SSL true,
    URL_COMPATIBILITY_MODE true
)

statement ok
CREATE OR REPLACE PERSISTENT SECRET s2 (
    TYPE R2,
    PROVIDER config,
    SCOPE 's3://my_r2_scope',
    ACCOUNT_ID 'some_bogus_account',
    KEY_ID 'mekey',
    SECRET 'mesecret',
    SESSION_TOKEN 'mesesh',
    URL_STYLE 'mahstyle',
    USE_SSL 1,
    URL_COMPATIBILITY_MODE 1
)

statement ok
CREATE OR REPLACE PERSISTENT SECRET s3 (
    TYPE GCS,
    PROVIDER config,
    SCOPE 's3://my_gcs_scope',
    KEY_ID 'mekey',
    SECRET 'mesecret',
    SESSION_TOKEN 'mesesh',
    URL_STYLE 'mahstyle',
    USE_SSL true,
    URL_COMPATIBILITY_MODE true
)

query IIII
select name, type, provider, scope FROM duckdb_secrets() order by name;
----
s1	s3	config	['s3://my_s3_scope']
s2	r2	config	['s3://my_r2_scope']
s3	gcs	config	['s3://my_gcs_scope']

# Preserve every configured option, including unredacted test credentials.
query I nosort unredacted_secret_rows
select secret_string from duckdb_secrets(redact=false) order by type;
----

# Default-redacted full rows must also serialize reproducibly.
query I nosort redacted_secret_rows
select * from duckdb_secrets() order by name;
----

restart

# A different, nonexistent secret directory contains no persistent secrets.
statement ok
set secret_directory='{TEST_DIR}/does_not_exist1'

query I
select count(*) FROM duckdb_secrets(redact=false);
----
0

restart

# Selecting the original directory restores all persisted secrets.
statement ok
set secret_directory='{TEST_DIR}/create_secret_serialization'

# After restart secrets are still there
query IIII
select name, type, provider, scope FROM duckdb_secrets() order by name;
----
s1	s3	config	['s3://my_s3_scope']
s2	r2	config	['s3://my_r2_scope']
s3	gcs	config	['s3://my_gcs_scope']

# Unredacted and redacted representations both match their pre-restart rows.
query I nosort unredacted_secret_rows
select secret_string from duckdb_secrets(redact=false) order by type;
----

query I nosort redacted_secret_rows
select * from duckdb_secrets() order by name;
----
