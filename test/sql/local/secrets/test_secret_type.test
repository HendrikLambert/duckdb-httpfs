# name: test/sql/local/secrets/test_secret_type.test
# description: HTTPFS registers the expected secret types and default providers
# group: [secret]

require httpfs

statement ok
PRAGMA enable_verification

query II
SELECT type, default_provider from duckdb_secret_types() where extension='httpfs' order by type;
----
aws	config
gcs	config
huggingface	config
r2	config
s3	config
