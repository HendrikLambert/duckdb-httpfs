# name: test/sql/local/encryption/different_aes_engines.test
# description: Encrypted databases written by mbedTLS and OpenSSL are readable by the other engine
# group: [encryption]

# Write with mbedTLS and read with OpenSSL.
foreach cipher GCM CTR

statement ok
SET force_mbedtls_unsafe = 'true';

statement ok
ATTACH '{TEST_DIR}/mbedtls_{cipher}.db' as enc (ENCRYPTION_KEY 'asdf', ENCRYPTION_CIPHER '{cipher}');

statement ok
CREATE TABLE enc.test (a INTEGER, b INTEGER);

statement ok
INSERT INTO enc.test VALUES (11, 22), (13, 22), (12, 21)

statement ok
DETACH enc

restart

require httpfs

statement ok
ATTACH '{TEST_DIR}/mbedtls_{cipher}.db' as enc (ENCRYPTION_KEY 'asdf', ENCRYPTION_CIPHER '{cipher}');

query II
FROM enc.test
----
11	22
13	22
12	21

restart

statement ok
SET force_mbedtls_unsafe = 'false';

endloop

# Write with OpenSSL and read with mbedTLS.
foreach cipher GCM CTR

require httpfs

statement ok
ATTACH '{TEST_DIR}/openssl_{cipher}.db' as enc (ENCRYPTION_KEY 'asdf', ENCRYPTION_CIPHER '{cipher}');

statement ok
CREATE TABLE enc.test (a INTEGER, b INTEGER);

statement ok
INSERT INTO enc.test VALUES (11, 22), (13, 22), (12, 21)

statement ok
DETACH enc

restart

statement ok
SET force_mbedtls_unsafe = 'true';

statement ok
ATTACH '{TEST_DIR}/openssl_{cipher}.db' as enc (ENCRYPTION_KEY 'asdf', ENCRYPTION_CIPHER '{cipher}');

query II
FROM enc.test
----
11	22
13	22
12	21

restart

endloop
